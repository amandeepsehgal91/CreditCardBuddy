
# Backend Environment Configuration

# Node environment
NODE_ENV=development

# Server
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credit_card_buddy
DB_USER=postgres
DB_PASSWORD=your_secure_password

# JWT (for future auth)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Api Version
API_VERSION=v1
